# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Só para chaves sk-ant-usr-…: ID do workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=

# WhatsApp Cloud API (developers.facebook.com → seu app → WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Qualquer texto que você inventar; o mesmo vai no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0

# Senha do agendador (a mesma usada em supabase/agendador.sql)
CRON_SECRET=
